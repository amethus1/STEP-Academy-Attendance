{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "STEP Academy Attendance",
  "version": "1.0.12",
  "identifier": "com.step.attendance",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "S.T.E.P. Academy Attendance",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/amethus1/STEP-Academy-Attendance/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2NDNGODU0RTAyMEFEQjkKUldTNXJTRGdWUGhEbHA5U09ZVytscHNqaHJxclFvMTRacS9RbWRYaEFMUkhYNHgxVW41YUU5TysK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}