{
  "compilerOptions": {
    /* ---------- Basics ---------- */
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "Node",
    "lib": ["DOM", "ES2021", "DOM.Iterable"],
    "jsx": "react-jsx",

    /* ---------- Paths + Output ---------- */
    "rootDir": ".",                   /* allow src + electron folders */
    "outDir": "dist-types",           /* type-only build (ignored by Vite) */
    "baseUrl": ".",                   /* enable absolute imports like "@/utils" */
    "paths": {
      "@/*": ["src/*"]
    },

    /* ---------- Strictness ---------- */
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowUnreachableCode": false,    /* catch unreachable code */
    "noFallthroughCasesInSwitch": true, /* safer switch statements */
    "isolatedModules": true,          /* better compatibility with Vite */

    /* ---------- Source-map & emit ---------- */
    "sourceMap": true,
    "noEmit": true,                   /* Vite handles JS output; TS only checks */
    
    /* ---------- Additional type checking ---------- */
    "noUnusedLocals": true,          /* catch unused variables */
    "noUnusedParameters": true,       /* catch unused parameters */
    "exactOptionalPropertyTypes": true /* stricter optional properties */
  },

  "include": [
    "src/**/*",
    "electron/**/*",
    "vite.config.ts"                  /* include Vite config for type checking */
  ],

  "exclude": [
    "node_modules",
    "dist",
    "dist-electron",
    "dist-types"
  ]
}